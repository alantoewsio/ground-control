# Normalise text files to LF in the index regardless of the
# checkout platform. This avoids massive CRLF-only diffs on Windows
# working trees.
* text=auto eol=lf

# Treat known binary types explicitly so they are never touched.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text
*.avif  binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
